{
  "manifest_version": 3,
  "name": "Copy4Chat",
  "version": "0.1.1",
  "description": "Copy a selection as structured text an LLM can understand.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],
  "background": {
    "service_worker": "src/background.js"
  }
}
